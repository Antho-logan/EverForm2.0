{
  "name": "everform-backend",
  "version": "2.0.0",
  "description": "Backend for EverForm - AI-powered biohacking & fitness coach",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "NODE_ENV=development ts-node-dev --respawn --transpile-only --ignore-watch node_modules --no-notify src/server.ts",
    "build": "tsc",
    "start": "NODE_ENV=production node dist/server.js",
    "job:weekly": "ts-node src/jobs/weeklyReport.ts",
    "job:daily": "ts-node src/jobs/dailySummary.ts",
    "lint:types": "tsc --noEmit",
    "lint:eslint": "eslint .",
    "lint": "npm run lint:types && npm run lint:eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.1",
    "@types/multer": "^2.0.0",
    "axios": "^1.6.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.12.12",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "supertest": "^7.0.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
